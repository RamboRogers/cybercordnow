# Public DNS name that points to your home's public IP address.
CYBERCORD_DOMAIN=chat.example.com

# Used by Caddy when requesting and renewing HTTPS certificates.
ACME_EMAIL=you@example.com

# Pin a specific CyberCord release. Change this manually when upgrading.
CYBERCORD_IMAGE=ghcr.io/ramborogers/cybercord-server:2.1.0

# CyberCord's binary defaults these advanced 2.1 voice-resilience gates off.
# This Compose stack enables them explicitly; set any value to false and
# restart the stack to roll back that layer without changing the image.
CYBERCORD_VOICE_RESILIENCE_ENABLED=true
CYBERCORD_VOICE_WORKER_ENABLED=true
CYBERCORD_VOICE_FEEDBACK_ENABLED=true

# Ports on the Docker host. Forward WAN TCP 80 and 443 to these ports.
CYBERCORD_HTTP_PORT=80
CYBERCORD_HTTPS_PORT=443

# Internal-only Caddy-to-CyberCord network. Change both values if this
# subnet overlaps another Docker network on your host.
CYBERCORD_INTERNAL_SUBNET=172.30.239.0/24
CADDY_INTERNAL_IP=172.30.239.2
CYBERCORD_INTERNAL_IP=172.30.239.3
